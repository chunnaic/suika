<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no">
<title>ブロックゲーム</title>
<link href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@500;900&display=swap" rel="stylesheet">
<style>
:root{--bg:#fbe9a6;--frame:#7a4a2a;--ink:#5a3419}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;height:100%}
body{background:radial-gradient(circle at 50% 0,#fff4bf,var(--bg));font-family:"Zen Maru Gothic",system-ui,sans-serif;color:var(--ink);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;padding:env(safe-area-inset-top) 12px env(safe-area-inset-bottom);touch-action:none;user-select:none;-webkit-user-select:none;overflow:hidden}
h1{margin:0;font-size:26px;font-weight:900;letter-spacing:.04em}
.hud{display:flex;gap:10px}
.hud div{background:#fff6d6;border:3px solid var(--frame);border-radius:14px;padding:4px 16px;text-align:center;font-size:12px;min-width:96px}
.hud b{display:block;font-size:22px;font-weight:900}
#board{width:min(92vw,420px,calc(100dvh - 340px));aspect-ratio:1;display:grid;grid-template-columns:repeat(8,1fr);gap:3px;padding:8px;background:#e9c97a;border:6px solid var(--frame);border-radius:22px;box-shadow:0 6px 0 #5a3419}
#board i,.piece i,.ghost i{border-radius:8px;display:block}
#board i{background:#fff2c4;box-shadow:inset 0 2px 0 #f0d88f}
.f,#board i.f{background:radial-gradient(circle at 32% 28%,#fff9 0 13%,transparent 15%),var(--c);box-shadow:inset 0 -4px 0 #0003,inset 0 2px 0 #fff6}
#board i.pv{background:var(--c);opacity:.5;box-shadow:none}
#board i.pop{animation:pop .3s forwards}
@keyframes pop{40%{transform:scale(1.15)}to{transform:scale(0);opacity:0}}
#msg{height:24px;font-weight:900;font-size:18px;color:#d6452b;transition:opacity .3s}
#tray{display:flex;gap:10px;width:min(92vw,420px)}
.slot{flex:1;height:calc(min(92vw,420px)/3.4);background:#fff6d6;border:3px solid var(--frame);border-radius:18px;display:flex;align-items:center;justify-content:center}
.piece{display:grid;gap:2px;touch-action:none;cursor:grab}
.ghost{position:fixed;left:0;top:0;display:grid;gap:3px;pointer-events:none;z-index:9;filter:drop-shadow(0 6px 4px #0003)}
#over{position:fixed;inset:0;background:#5a341999;display:none;align-items:center;justify-content:center;z-index:20}
#over.on{display:flex}
#over>div{background:#fff6d6;border:6px solid var(--frame);border-radius:26px;padding:24px 34px;text-align:center}
#over p{margin:0;font-size:24px;font-weight:900}
#over b{display:block;font-size:44px;font-weight:900;margin:6px 0 14px}
button{font:inherit;font-weight:900;font-size:18px;color:#fff;background:#d6452b;border:0;border-radius:16px;padding:10px 26px;box-shadow:0 4px 0 #8f2a18;cursor:pointer}
button:active{transform:translateY(3px);box-shadow:0 1px 0 #8f2a18}
@media(prefers-reduced-motion:reduce){#board i.pop{animation-duration:.01s}}
</style>
</head>
<body>
<h1>🍉 ブロックゲーム</h1>
<div class="hud"><div>スコア<b id="sc">0</b></div><div>ベスト<b id="bs">0</b></div></div>
<div id="board"></div>
<div id="msg"></div>
<div id="tray"></div>
<div id="over"><div><p>ゲームオーバー</p><b id="fs">0</b><button id="re">もう一回</button></div></div>
<script>
const MULT=1.5,N=8,$=s=>document.querySelector(s),B=$('#board'),T=$('#tray');
const COL=['#ef5350','#ff9f43','#ffd93d','#7bc74d','#a55eea','#f78fb3'];
const SH=['#','##','###','####','#####','##/##','###/###/###','#./##','#../#../###','###/###','###/.#.','##./.##','#./#./##','#../###'].map(s=>s.split('/').map(r=>[...r].map(c=>c==='#')));
let G,P,score,best=0,pitch=44,drag=null,cells=[];
try{best=+localStorage.getItem('bb-best')||0}catch(e){}
const rot=m=>m[0].map((_,c)=>m.map(r=>r[c]).reverse());
function mk(){let m=SH[Math.random()*SH.length|0];for(let k=Math.random()*4|0;k--;)m=rot(m);return{m,h:m.length,w:m[0].length,col:COL[Math.random()*COL.length|0]}}
function fill(d,p){d.innerHTML='';p.m.forEach(r=>r.forEach(v=>{const x=document.createElement('i');if(v){x.className='f';x.style.setProperty('--c',p.col)}d.append(x)}))}
function setGrid(d,p,s,gap){d.style.gridTemplateColumns=`repeat(${p.w},${s}px)`;d.style.gridAutoRows=s+'px';d.style.gap=gap+'px'}
function init(){
  B.innerHTML='';cells=[];for(let i=0;i<N*N;i++){const x=document.createElement('i');B.append(x);cells.push(x)}
  G=Array(N*N).fill(null);score=0;P=[mk(),mk(),mk()];$('#over').classList.remove('on');draw();tray();
}
function measure(){pitch=cells[1].getBoundingClientRect().left-cells[0].getBoundingClientRect().left}
function draw(){
  G.forEach((v,i)=>{const x=cells[i];x.className=v?'f':'';v?x.style.setProperty('--c',v):x.style.removeProperty('--c')});
  $('#sc').textContent=score;$('#bs').textContent=best;
}
function tray(){
  measure();T.innerHTML='';
  P.forEach((p,i)=>{const s=document.createElement('div');s.className='slot';
    if(p){const d=document.createElement('div');d.className='piece';d.dataset.i=i;setGrid(d,p,Math.min(pitch*.5,22),2);fill(d,p);s.append(d)}
    T.append(s)});
}
const fits=(p,r,c)=>r>=0&&c>=0&&r+p.h<=N&&c+p.w<=N&&p.m.every((row,y)=>row.every((v,x)=>!v||!G[(r+y)*N+c+x]));
function pos(e){
  const o=cells[0].getBoundingClientRect(),{p,g}=drag,lift=e.pointerType==='touch'?70:20;
  const left=e.clientX-p.w*pitch/2,top=e.clientY-p.h*pitch-lift;
  g.style.transform=`translate(${left}px,${top}px)`;
  return[Math.round((top-o.top)/pitch),Math.round((left-o.left)/pitch)];
}
function preview(r,c){
  cells.forEach(x=>{x.classList.remove('pv')});
  const{p}=drag;if(!fits(p,r,c))return false;
  p.m.forEach((row,y)=>row.forEach((v,x)=>{if(v){const el=cells[(r+y)*N+c+x];el.classList.add('pv');el.style.setProperty('--c',p.col)}}));return true;
}
T.addEventListener('pointerdown',e=>{
  const el=e.target.closest('.piece');if(!el||drag)return;
  measure();const p=P[+el.dataset.i],g=document.createElement('div');
  g.className='ghost';setGrid(g,p,pitch-3,3);fill(g,p);document.body.append(g);
  drag={i:+el.dataset.i,p,g,el};el.style.opacity=.25;
  const[r,c]=pos(e);preview(r,c);
});
addEventListener('pointermove',e=>{if(!drag)return;const[r,c]=pos(e);preview(r,c)});
addEventListener('pointerup',e=>{
  if(!drag)return;const[r,c]=pos(e),{p,i,g}=drag;g.remove();drag=null;
  cells.forEach(x=>x.classList.remove('pv'));
  if(fits(p,r,c))place(p,i,r,c);else tray();
});
addEventListener('pointercancel',()=>{if(drag){drag.g.remove();drag=null;draw();tray()}});
function place(p,i,r,c){
  let n=0;p.m.forEach((row,y)=>row.forEach((v,x)=>{if(v){G[(r+y)*N+c+x]=p.col;n++}}));
  score+=Math.round(n*MULT);P[i]=null;
  const kill=new Set();let lines=0;
  for(let a=0;a<N;a++){
    if([...Array(N)].every((_,b)=>G[a*N+b])){lines++;for(let b=0;b<N;b++)kill.add(a*N+b)}
    if([...Array(N)].every((_,b)=>G[b*N+a])){lines++;for(let b=0;b<N;b++)kill.add(b*N+a)}
  }
  draw();
  if(lines){
    score+=Math.round(lines*(lines+1)*5*MULT);
    kill.forEach(k=>cells[k].classList.add('pop'));
    const m=$('#msg');m.textContent=lines>1?`${lines}ライン! 🍉`:'ナイス!';m.style.opacity=1;setTimeout(()=>m.style.opacity=0,900);
  }
  setTimeout(()=>{
    kill.forEach(k=>G[k]=null);
    if(!P.some(Boolean))P=[mk(),mk(),mk()];
    if(score>best){best=score;try{localStorage.setItem('bb-best',best)}catch(e){}}
    draw();tray();check();
  },lines?300:0);
}
function check(){
  const ok=P.some(p=>p&&(()=>{for(let r=0;r<N;r++)for(let c=0;c<N;c++)if(fits(p,r,c))return true})());
  if(!ok){$('#fs').textContent=score;$('#over').classList.add('on')}
}
$('#re').onclick=init;addEventListener('resize',()=>{if(!drag)tray()});
init();
</script>
</body>
</html>
